# ─────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=gaatshort-api
APP_PORT=3000
APP_GLOBAL_PREFIX=api
APP_DEFAULT_API_VERSION=1
APP_PUBLIC_URL=http://localhost:3000
# Fixée dans l'image par la CI (SHA du commit) — ne pas définir à la main.
# APP_VERSION=dev
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://gaatshort.com

# ─────────────────────────────────────────────────────────────
# MULTI-TENANCY
# ─────────────────────────────────────────────────────────────
# shared_rls  -> une base, un schéma, colonne tenant_id + Row Level Security (défaut)
# schema      -> un schéma Postgres par tenant (mode "silo", clients premium)
TENANCY_STRATEGY=shared_rls
# Ordre de résolution du tenant, du plus prioritaire au moins prioritaire
TENANCY_RESOLVERS=jwt,subdomain,header
TENANCY_HEADER_NAME=x-tenant-id
TENANCY_ROOT_DOMAIN=gaatshort.com
TENANCY_DEFAULT_SLUG=gaatshort
TENANCY_CACHE_TTL_SECONDS=300
# Autorise les routes marketing publiques sans tenant explicite (fallback slug par défaut)
TENANCY_ALLOW_ANONYMOUS_FALLBACK=true

# ─────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://gaatshort:gaatshort@localhost:5432/gaatshort?schema=public&connection_limit=20&pool_timeout=10
# `prisma/schema.prisma` déclare `directUrl` (connexion directe, hors pooler,
# utilisée par `prisma migrate deploy`/`db execute`) : la clé doit exister
# dans l'environnement, même identique à DATABASE_URL — sa seule ABSENCE fait
# échouer la validation du schéma (« Environment variable not found »), pas
# seulement une valeur invalide. Pas de pooler devant Postgres ici : même URL.
DATABASE_DIRECT_URL=postgresql://gaatshort:gaatshort@localhost:5432/gaatshort?schema=public
# Rôle applicatif NON superuser : indispensable pour que la RLS s'applique réellement
DATABASE_APP_ROLE=gaatshort_app
DATABASE_READ_REPLICA_URL=
DATABASE_LOG_QUERIES=false
DATABASE_SLOW_QUERY_MS=300

# ─────────────────────────────────────────────────────────────
# REDIS (cache, files BullMQ, rate limit, idempotence, locks)
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=gs
CACHE_DEFAULT_TTL_SECONDS=60

# ─────────────────────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-32-chars-minimum-please
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=change-me-too-32-chars-minimum-ok
JWT_REFRESH_TTL=30d
MAGIC_LINK_TTL_SECONDS=900
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2

# ─────────────────────────────────────────────────────────────
# STORAGE (S3 compatible : AWS S3, Scaleway, MinIO)
# ─────────────────────────────────────────────────────────────
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=eu-west-1
STORAGE_BUCKET=gaatshort-media
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PRESIGN_TTL_SECONDS=900
STORAGE_DOWNLOAD_TTL_SECONDS=900
STORAGE_MAX_FILE_SIZE_MB=15
STORAGE_ALLOWED_MIME=application/pdf,image/png,image/jpeg,image/webp

# ─────────────────────────────────────────────────────────────
# MAIL / SMS
# ─────────────────────────────────────────────────────────────
MAIL_DRIVER=smtp
MAIL_FROM="Gaatshort <no-reply@gaatshort.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMS_DRIVER=log
SMS_SENDER_ID=GAATSHRT

# ─────────────────────────────────────────────────────────────
# OBSERVABILITÉ
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_PRETTY=true
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# ─────────────────────────────────────────────────────────────
# RATE LIMIT
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=120
RATE_LIMIT_PUBLIC_FORM_LIMIT=5

# ─────────────────────────────────────────────────────────────
# CONFORMITÉ / RGPD
# ─────────────────────────────────────────────────────────────
GDPR_RETENTION_APPLICATION_DAYS=730
GDPR_RETENTION_REJECTED_DAYS=365
GDPR_EXPORT_TTL_HOURS=48

# ─────────────────────────────────────────────────────────────
# VIDÉO — `fake` en local (flux HLS de démonstration), `bunny` en staging/production
# ─────────────────────────────────────────────────────────────
VIDEO_DRIVER=fake
VIDEO_PLAYBACK_TTL_SECONDS=14400
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOST=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# PAIEMENT — `fake` en local (validation simulée), `paytech` en staging/production
# ─────────────────────────────────────────────────────────────
PAYMENT_DRIVER=fake
PAYMENT_ORDER_TTL_MINUTES=30
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test
PAYTECH_SUCCESS_URL=
PAYTECH_CANCEL_URL=

# Compte SUPER_ADMIN du back-office, créé par `pnpm db:seed` (sauté si le mot de passe est vide)
SEED_ADMIN_EMAIL=admin@gaatshort.com
SEED_ADMIN_PASSWORD=
