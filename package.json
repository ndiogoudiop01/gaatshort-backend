{
  "name": "@gaatshort/backend",
  "version": "0.1.0",
  "description": "Gaatshort — Backend API (NestJS, modular monolith, multi-tenant)",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.11 <25"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.main.js",
    "start:worker:dev": "nest start --watch --entryFile worker.main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:ci": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "depcruise": "depcruise src",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:ci": "jest --coverage --ci --runInBand --coverageReporters=text-summary --coverageReporters=cobertura --reporters=default --reporters=jest-junit",
    "test:integration": "jest --config test/jest-integration.json --runInBand",
    "test:integration:ci": "jest --config test/jest-integration.json --runInBand --ci --forceExit --reporters=default --reporters=jest-junit",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:arch": "jest --config test/jest-arch.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:rls": "prisma db execute --file prisma/sql/rls-policies.sql --schema prisma/schema.prisma",
    "db:indexes": "node scripts/run-sql-statements.mjs prisma/sql/indexes.sql",
    "db:partitions": "prisma db execute --file prisma/sql/partitions.sql --schema prisma/schema.prisma && pnpm db:rls",
    "db:seed": "ts-node -r tsconfig-paths/register prisma/seed/index.ts",
    "db:seed:prod": "ts-node -r tsconfig-paths/register prisma/seed/index.ts --allow-production",
    "build:seed": "tsc -p tsconfig.seed.json",
    "db:seed:dist": "node dist/seed/index.js --allow-production",
    "db:studio": "prisma studio",
    "diagnose:login": "ts-node -r tsconfig-paths/register scripts/diagnose-login.ts",
    "openapi:export": "ts-node -r tsconfig-paths/register scripts/export-openapi.ts",
    "openapi:diff": "pnpm openapi:export && git diff --exit-code -- openapi.json",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-presigned-post": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@casl/ability": "^6.7.3",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/cache-manager": "^3.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/cqrs": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/client": "^6.2.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "cache-manager": "^6.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.5",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "nestjs-cls": "^5.0.0",
    "nestjs-pino": "^4.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^10.3.0",
    "prisma": "^6.2.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "2.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "lint-staged": "^15.2.11",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed/index.ts"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1",
      "^@infra/(.*)$": "<rootDir>/infrastructure/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@config/(.*)$": "<rootDir>/config/$1"
    },
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 75,
        "lines": 80,
        "statements": 80
      },
      "**/modules/*/domain/**/*.ts": {
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  },
  "pnpm": {
    "overrides": {
      "proxy-addr@<2.0.8": ">=2.0.8",
      "compression@<1.8.2": ">=1.8.2",
      "sanitize-html@<2.17.7": ">=2.17.7",
      "js-yaml@>=5.0.0 <5.4.1": ">=5.4.1",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "@grpc/grpc-js@>=1.14.0 <1.14.5": "^1.14.5",
      "source-map-js@<1.2.2": "^1.2.2",
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "follow-redirects@<1.16.1": "^1.16.1",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "multer@<2.5.0": "^2.5.0"
    }
  }
}
