  "info": {
    "title": "Gaatshort — API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RequestChallengeDto": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "EMAIL_MAGIC_LINK",
              "EMAIL_OTP",
              "PHONE_OTP"
            ]
          },
          "identifier": {
            "type": "string",
            "description": "E-mail ou téléphone au format E.164",
            "example": "+221771234567"
          }
        },
        "required": [
          "channel",
          "identifier"
        ]
      },
      "VerifyChallengeDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string"
          },
          "secret": {
            "type": "string",
            "description": "Code OTP ou jeton du lien magique"
          }
        },
        "required": [
          "identifier",
          "secret"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@gaatshort.com"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "object",
            "nullable": true,
            "maxLength": 80
          },
          "lastName": {
            "type": "object",
            "nullable": true,
            "maxLength": 80
          },
          "phoneE164": {
            "type": "object",
            "nullable": true,
            "example": "+221771234567"
          },
          "countryCode": {
            "type": "object",
            "nullable": true,
            "example": "SN",
            "description": "Pays de rattachement"
          },
          "email": {
            "type": "string",
            "example": "awa.diop@gaatshort.com"
          },
          "roleKeys": {
            "example": [
              "MANAGER"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "email",
          "roleKeys"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "object",
            "nullable": true,
            "maxLength": 80
          },
          "lastName": {
            "type": "object",
            "nullable": true,
            "maxLength": 80
          },
          "phoneE164": {
            "type": "object",
            "nullable": true,
            "example": "+221771234567"
          },
          "countryCode": {
            "type": "object",
            "nullable": true,
            "example": "SN",
            "description": "Pays de rattachement"
          }
        }
      },
      "SetUserRolesDto": {
        "type": "object",
        "properties": {
          "roleKeys": {
            "example": [
              "MANAGER"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "roleKeys"
        ]
      },
      "SetUserStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "SetUserCountriesDto": {
        "type": "object",
        "properties": {
          "allCountries": {
            "type": "boolean",
            "description": "`true` : tous les pays du tenant"
          },
          "countryScope": {
            "example": [
              "MA"
            ],
            "description": "Pays accordés EN PLUS du pays de rattachement",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "allCountries",
          "countryScope"
        ]
      },
      "CreateRoleDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "example": "REGIONAL_MANAGER",
            "description": "Majuscules, chiffres et _ (3 à 40)"
          },
          "name": {
            "type": "string",
            "example": "Gestionnaire régional"
          },
          "description": {
            "type": "object",
            "nullable": true
          },
          "copyFrom": {
            "type": "string",
            "example": "MANAGER",
            "description": "Rôle dont copier les permissions"
          }
        },
        "required": [
          "key",
          "name"
        ]
      },
      "UpdateRoleDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "name"
        ]
      },
      "SetRolePermissionsDto": {
        "type": "object",
        "properties": {
          "permissionKeys": {
            "example": [
              "pool:read",
              "partner:read"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "permissionKeys"
        ]
      },
      "TenantBrandingDto": {
        "type": "object",
        "properties": {
          "primaryColor": {
            "type": "object",
            "nullable": true,
            "example": "#0F5132"
          },
          "logoUrl": {
            "type": "object",
            "nullable": true,
            "example": "https://cdn.exemple.org/logo.svg"
          }
        }
      },
      "CreateTenantDto": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "example": "kaay-cote-ivoire",
            "description": "Sous-domaine, immuable : 3–63 caractères a-z, 0-9, tiret"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "example": "Gaatshort Côte d’Ivoire"
          },
          "legalName": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ],
            "default": "ACTIVE",
            "description": "SUSPENDED : préparer l’organisation avant ouverture"
          },
          "defaultLocale": {
            "type": "string",
            "example": "fr",
            "default": "fr"
          },
          "defaultCountry": {
            "type": "string",
            "example": "CI",
            "description": "Pays actif du référentiel"
          },
          "defaultCurrency": {
            "type": "string",
            "example": "XOF",
            "description": "Par défaut : la devise du pays"
          },
          "timezone": {
            "type": "string",
            "example": "Africa/Abidjan",
            "description": "Par défaut : le fuseau connu du pays"
          },
          "countries": {
            "example": [
              "CI",
              "BF"
            ],
            "description": "Pays rattachés en plus du pays par défaut",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "branding": {
            "$ref": "#/components/schemas/TenantBrandingDto"
          },
          "featureFlags": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            },
            "example": {
              "simulator": true,
              "academy": false
            }
          }
        },
        "required": [
          "slug",
          "name",
          "defaultCountry"
        ]
      },
      "UpdateTenantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "legalName": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED",
              "ARCHIVED"
            ],
            "description": "SUSPENDED / ARCHIVED coupent l’accès IMMÉDIATEMENT"
          },
          "defaultLocale": {
            "type": "string",
            "example": "fr"
          },
          "defaultCountry": {
            "type": "string",
            "example": "SN"
          },
          "defaultCurrency": {
            "type": "string",
            "example": "XOF"
          },
          "timezone": {
            "type": "string",
            "example": "Africa/Dakar"
          },
          "branding": {
            "$ref": "#/components/schemas/TenantBrandingDto"
          },
          "featureFlags": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            },
            "example": {
              "simulator": true
            }
          }
        }
      },
      "ConsentEntryDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "example": "personal_data_processing"
          },
          "granted": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "granted"
        ]
      },
      "RecordConsentsDto": {
        "type": "object",
        "properties": {
          "consents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsentEntryDto"
            }
          }
        },
        "required": [
          "consents"
        ]
      }
    }
  }
}